{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    // 빌드 결과물(dist → 설치 파일의 app.asar)에 주석을 남기지 않는다 — 2026-11-26 주석 속 "예:" 값이 실제 계좌번호였고 설치 파일에까지 배포됐다.
    // 주석은 소스에만 둔다. 그래도 예시값은 항상 가짜로 쓴다(루트 CLAUDE.md).
    "removeComments": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  // 예전 빌드 내장 키 파일들(수출입은행 인증키·Google OAuth 클라이언트 — gitignore, 개발자 PC에만 남아 있을 수 있음) — 이제 쓰지 않는다. 남아 있어도
  // dist에 컴파일돼 앱에 실리지 않게 뺀다(2026-11-16, 인증키는 설정에서 사용자가 입력).
  "exclude": ["src/fx/eximbankConfig.ts", "src/google/clientConfig.ts"]
}
