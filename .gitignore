node_modules/
dist/
release/

# `build/`는 여기서 무시하지 않는다 — electron-builder의 buildResources 폴더와
# 이름이 같아서, 그 줄이 있으면 build/icon.icns|ico|png|svg(세 OS 앱 아이콘)가
# 커밋에서 조용히 빠진다. 빌드 산출물은 전부 dist/ · release/로 나가므로
# build/는 소스로만 쓰인다.
*.log
.DS_Store

# Local encrypted credential store & user data (per-machine, never commit)
backend/data/
electron/userData/
*.env
.env.*

# 앱 배포용 Google OAuth Client ID/Secret — 빌드에 컴파일해 넣는 값이라 커밋하지
# 않는다(clientConfig.example.ts가 템플릿). backend/CLAUDE.md의 "Google Sheets
# 연동" 절 참고.
backend/src/google/clientConfig.ts

# 앱 배포용 한국수출입은행 Open API 인증키 — 위와 같은 이유로 빌드에 컴파일해
# 넣는다(eximbankConfig.example.ts가 템플릿).
backend/src/fx/eximbankConfig.ts

# scripts/generate-app-info.cjs가 매 빌드마다 새로 만든다(버전 + OSS 패키지
# 목록) — backend/CLAUDE.md의 "앱 정보(About)" 절 참고.
backend/src/generated/

# Per-machine Claude Code settings (not shared across machines)
.claude/settings.local.json
