{
  "name": "mystock-api",
  "private": true,
  "version": "0.1.0",
  "description": "여러 증권사 Open API를 연동해 보유 종목, 손익, 비중, 배당금을 보여주는 데스크톱 앱",
  "author": "ultracat",
  "main": "electron/dist/main.js",
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:electron": "npm run dev --workspace electron",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:electron": "npm run build --workspace electron",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "dev": "npm run build:backend && concurrently -k -n frontend,electron \"npm:dev:frontend\" \"npm:dev:electron\"",
    "package:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.ultracat.mystock",
    "productName": "MyStock",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*",
      "electron/package.json",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/typescript/**",
      "!node_modules/vite/**",
      "!node_modules/@vitejs/**",
      "!node_modules/tsx/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/rollup/**",
      "!node_modules/@rollup/**",
      "!node_modules/concurrently/**",
      "!node_modules/.bin/**",
      "!node_modules/@mystock/**",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!electron/src/**",
      "!backend/src/**",
      "!frontend/src/**",
      {
        "from": "backend",
        "to": "node_modules/@mystock/backend",
        "filter": ["package.json", "dist/**/*"]
      }
    ],
    "asar": false,
    "mac": {
      "category": "public.app-category.finance",
      "target": ["dmg"],
      "identity": null
    }
  }
}
