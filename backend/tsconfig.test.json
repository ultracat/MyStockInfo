{
  // 테스트 파일 타입 검사용(빌드 산출물 없음) — tsconfig.json은 src만 보고, tsx --test는 타입을 지우기만 해서
  // test/** 타입 오류가 아무 데서도 안 걸렸다. 루트 `npm run typecheck:test`(CI 포함)가 쓴다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    // 테스트는 tsx가 실행한다 — 테스트 안의 동적 `await import('../src/x')`를 tsx처럼(확장자 없이) 해석하게 한다.
    // 빌드(tsconfig.json)는 Node16이라 동적 import도 ESM 규칙(확장자 필수)으로 본다. src는 빌드가 Node16으로 따로 검사한다.
    "module": "Preserve",
    "moduleResolution": "Bundler"
  },
  "include": ["src", "test"]
}
