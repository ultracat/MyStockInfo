{
  "name": "mystock-api",
  "private": true,
  "version": "1.6.0",
  "description": "여러 증권사 Open API를 연동해 보유 종목, 손익, 비중, 배당금을 보여주는 데스크톱 앱",
  "author": "ChangWoo Lee <ultracat.lcw@gmail.com>",
  "license": "AGPL-3.0-only",
  "main": "electron/dist/main.js",
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:electron": "node scripts/dev-electron.cjs",
    "generate:app-info": "node scripts/generate-app-info.cjs",
    "generate:icons": "electron scripts/generate-icons.cjs",
    "build:backend": "npm run generate:app-info && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:electron": "npm run build --workspace electron",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "test": "npm run test --workspace backend && npm run test --workspace frontend && npm run test:electron",
    "check:nh": "npm run build:backend && electron scripts/nh-live-check.cjs",
    "check:kiwoom": "npm run build:backend && electron scripts/kiwoom-live-check.cjs",
    "check:kis": "npm run build:backend && electron scripts/kis-live-check.cjs",
    "check:toss": "npm run build:backend && electron scripts/toss-live-check.cjs",
    "release:tag": "node scripts/release.cjs tag",
    "release:build": "node scripts/release.cjs build",
    "dev": "npm run build:backend && node scripts/dev.cjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win",
    "lint": "eslint .",
    "spec:check": "node scripts/spec-watch.cjs check",
    "spec:update": "node scripts/spec-watch.cjs update",
    "spec:types": "node scripts/spec-watch.cjs types",
    "kis:verify": "node scripts/kis-verify.cjs verify",
    "kis:catalog": "node scripts/kis-verify.cjs catalog",
    "kis:types": "node scripts/kis-verify.cjs types",
    "kis:record": "npm run build:backend && electron scripts/kis-live-check.cjs --record",
    "check:kb": "npm run build:backend && electron scripts/kb-live-check.cjs",
    "check:ls": "npm run build:backend && electron scripts/ls-live-check.cjs",
    "check:db": "npm run build:backend && electron scripts/db-live-check.cjs",
    "typecheck:test": "tsc -p backend/tsconfig.test.json && tsc -p frontend/tsconfig.test.json && tsc -p electron/tsconfig.test.json",
    "test:electron": "tsx --test \"electron/test/*.test.ts\""
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.7",
    "electron-builder": "^26.18.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0"
  },
  "build": {
    "appId": "com.ultracat.mystock",
    "productName": "MyStock",
    "copyright": "Copyright © 2026 ChangWoo Lee",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/dist/**/*",
      "electron/assets/**/*",
      "electron/package.json",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/typescript/**",
      "!node_modules/vite/**",
      "!node_modules/@vitejs/**",
      "!node_modules/tsx/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/rollup/**",
      "!node_modules/@rollup/**",
      "!node_modules/concurrently/**",
      "!node_modules/.bin/**",
      "!node_modules/@mystock/**",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!electron/src/**",
      "!backend/src/**",
      "!frontend/src/**",
      {
        "from": "backend",
        "to": "node_modules/@mystock/backend",
        "filter": [
          "package.json",
          "dist/**/*",
          "!dist/**/*.d.ts",
          "!dist/**/*.map"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
