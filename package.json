{
  "name": "mystock-api",
  "private": true,
  "version": "1.0.0",
  "description": "여러 증권사 Open API를 연동해 보유 종목, 손익, 비중, 배당금을 보여주는 데스크톱 앱",
  "author": "ChangWoo Lee <ultracat.lcw@gmail.com>",
  "license": "AGPL-3.0-only",
  "main": "electron/dist/main.js",
  "workspaces": [
    "backend",
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "dev:electron": "npm run dev --workspace electron",
    "generate:app-info": "node scripts/generate-app-info.cjs",
    "generate:icons": "electron scripts/generate-icons.cjs",
    "build:backend": "npm run generate:app-info && npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:electron": "npm run build --workspace electron",
    "build": "npm run build:backend && npm run build:frontend && npm run build:electron",
    "test": "npm run test --workspace backend",
    "dev": "npm run build:backend && node scripts/dev.cjs",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3"
  },
  "build": {
    "appId": "com.ultracat.mystock",
    "productName": "MyStock",
    "copyright": "Copyright © 2026 ChangWoo Lee",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/dist/**/*",
      "electron/assets/**/*",
      "electron/package.json",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!node_modules/electron/**",
      "!node_modules/electron-builder/**",
      "!node_modules/typescript/**",
      "!node_modules/vite/**",
      "!node_modules/@vitejs/**",
      "!node_modules/tsx/**",
      "!node_modules/esbuild/**",
      "!node_modules/@esbuild/**",
      "!node_modules/rollup/**",
      "!node_modules/@rollup/**",
      "!node_modules/concurrently/**",
      "!node_modules/.bin/**",
      "!node_modules/@mystock/**",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!electron/src/**",
      "!backend/src/**",
      "!frontend/src/**",
      {
        "from": "backend",
        "to": "node_modules/@mystock/backend",
        "filter": [
          "package.json",
          "dist/**/*",
          "!dist/**/*.d.ts",
          "!dist/**/*.map"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "afterPack": "scripts/afterPack-mac-finalize.cjs",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.finance",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    }
  }
}
